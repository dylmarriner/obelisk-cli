# Obelisk CLI — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env files to version control.

# Nexus Remote Memory
NEXUS_ENDPOINT=http://100.68.0.96:7777
NEXUS_API_KEY=replace_with_long_random_value
NEXUS_TIMEOUT_MS=5000
NEXUS_HEALTH_TIMEOUT_MS=1500
NEXUS_RETRIES=3
NEXUS_OFFLINE_CACHE=.obelisk/cache/memory-outbox.sqlite

# Model Provider API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=

# Obelisk Core
OBELISK_MAX_INPUT_TOKENS=120000
OBELISK_RESERVE_OUTPUT_TOKENS=12000
OBELISK_REQUIRE_APPROVAL_FOR_DANGEROUS_COMMANDS=true

# Optional: Override config paths
# OBELISK_CONFIG_DIR=/path/to/config
# OBELISK_CONFIG=/path/to/obelisk.config.jsonc

# Optional: CocoIndex (future)
# COCOINDEX_DISABLE_USAGE_TRACKING=1